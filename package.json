{
	"name": "astro-startligh-docs",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"cf:build": "astro build",
		"cf:deploy": "wrangler pages deploy ./dist --project-name vending-docs",
		"check": "astro check",
		"lint": "oxlint --fix",
		"md": "rumdl check .",
		"fmt": "oxfmt --write . && rumdl fmt .",
		"fmt:check": "oxfmt --check . && rumdl check .",
		"type": "tsc --noEmit",
		"unused": "knip",
		"verify": "bun run fmt && bun run lint && bun run md && bun run type && bun run check && bun run build"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.6",
		"@astrojs/svelte": "^9.0.1",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"astro": "^7.3.8",
		"astro-d2": "^0.14.0",
		"astro-icon": "^1.2.0",
		"astro-mermaid": "^2.1.0",
		"expressive-code-color-chips": "^0.2.1",
		"expressive-code-fullscreen": "^2.0.0",
		"expressive-code-twoslash": "^0.6.1",
		"mermaid": "^12.1.0",
		"starlight-github-alerts": "^0.5.0",
		"starlight-heading-badges": "^0.8.0",
		"starlight-image-zoom": "^0.16.1",
		"starlight-links-validator": "^0.27.0",
		"starlight-scroll-to-top": "^2.0.0",
		"svelte": "^5.57.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@fontsource-variable/geist": "^5.3.0",
		"@iconify-json/lucide": "^1.2.142",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4"
	},
	"packageManager": "bun@1.4.2",
	"knip": {
		"ignoreDependencies": [
			"@iconify-json/lucide"
		],
		"ignoreBinaries": [
			"wrangler",
			"oxlint",
			"oxfmt",
			"rumdl",
			"tsc",
			"knip"
		]
	}
}
