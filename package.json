{
	"name": "astro-docs",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"cf:deploy": "wrangler pages deploy ./dist --project-name vending-docs",
		"check": "astro check",
		"lint": "oxlint --fix",
		"md": "rumdl check .",
		"fmt": "oxfmt --write . && rumdl fmt .",
		"fmt:check": "oxfmt --check . && rumdl check .",
		"type": "tsc --noEmit",
		"verify": "bun run fmt && bun run lint && bun run md && bun run type && bun run check && bun run build"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.6",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"astro": "^7.3.8",
		"astro-d2": "^0.14.0",
		"astro-mermaid": "^2.1.0",
		"expressive-code-color-chips": "^0.2.1",
		"expressive-code-fullscreen": "^2.0.0",
		"mermaid": "^12.1.0",
		"starlight-github-alerts": "^0.5.0",
		"starlight-image-zoom": "^0.16.1",
		"starlight-links-validator": "^0.27.0",
		"starlight-scroll-to-top": "^2.0.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5"
	}
}
