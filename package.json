{
	"name": "astro-startligh-docs",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@12.2.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"cf:build": "astro build",
		"cf:deploy": "wrangler pages deploy ./dist --project-name vending-docs",
		"check": "astro check",
		"lint": "biome check --write .",
		"md": "rumdl check .",
		"fmt": "biome check --write . && rumdl fmt .",
		"fmt:check": "biome check . && rumdl check .",
		"type": "tsc --noEmit",
		"unused": "knip",
		"verify": "pnpm lint && pnpm md && pnpm type && pnpm check && pnpm build"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.0",
		"@astrojs/svelte": "^9.0.1",
		"@expressive-code/plugin-collapsible-sections": "^0.44.2",
		"@expressive-code/plugin-line-numbers": "^0.44.2",
		"astro": "^7.2.10",
		"astro-d2": "^0.13.1",
		"astro-icon": "^1.2.0",
		"astro-mermaid": "^2.1.0",
		"expressive-code-color-chips": "^0.2.0",
		"expressive-code-fullscreen": "^2.0.0",
		"expressive-code-twoslash": "^0.6.1",
		"mermaid": "^11.17.2",
		"starlight-github-alerts": "^0.4.0",
		"starlight-heading-badges": "^0.8.0",
		"starlight-image-zoom": "^0.16.0",
		"starlight-links-validator": "^0.26.0",
		"starlight-scroll-to-top": "^2.0.0",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@fontsource-variable/geist": "^5.3.0",
		"@iconify-json/lucide": "^1.2.129",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.1"
	},
	"knip": {
		"ignoreDependencies": [
			"@iconify-json/lucide"
		],
		"ignoreBinaries": [
			"wrangler",
			"biome",
			"rumdl",
			"tsc",
			"knip"
		]
	}
}
