---
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

const { sidebar } = (Astro.locals as { starlightRoute: StarlightRouteData })
	.starlightRoute;
const { pathname } = Astro.url;

const SECTION_MAP: Record<string, string> = {
	"/mqtt5": "MQTT 5",
	"/sse": "SSE",
	"/websocket": "WebSocket",
};

const activeSection = Object.entries(SECTION_MAP).find(([prefix]) =>
	pathname.startsWith(prefix)
)?.[1];

const filteredSidebar =
	pathname === "/"
		? []
		: activeSection
			? sidebar.filter((entry) => entry.label === activeSection)
			: sidebar;

---

<SidebarPersister>
	<SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
